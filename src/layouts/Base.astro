---
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  /** リンクプレビュー用の画像(public/ 以下のパス)。PNG/JPEG/WebP/GIF以外は既定画像になる */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  author?: string;
}
const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  publishedTime,
  tags = [],
  author,
} = Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : SITE.title;

// リンクプレビュー(OGP)は絶対URLが必要
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const RASTER = /\.(png|jpe?g|webp|gif)(\?.*)?$/i;
const ogImage = new URL(image && RASTER.test(image) ? image : SITE.ogImage, site).href;
---

<!doctype html>
<html lang={SITE.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#000000" />
    {author && <meta name="author" content={author} />}

    <!-- リンクプレビュー(Discord / X / Slack など) -->
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{fullTitle}</title>
    <!-- 描画前にテーマを決めて、白黒のちらつきを防ぐ -->
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-icon" href="/" aria-label="トップページへ">
          <img src="/icon.svg" alt="" width="40" height="40" />
        </a>
        <a class="site-title" href="/">{SITE.title}</a>
        <nav class="site-nav" aria-label="メイン">
          <a href="/posts/">記事</a>
          <a href="/tags/">タグ</a>
          <a href="/links/">リンク</a>
          <button type="button" id="theme-toggle" aria-pressed="false">白 / 黒</button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <small>© {new Date().getFullYear()} {SITE.title}</small>
    </footer>

    <script>
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle');
      const sync = () => btn?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
      sync();
      btn?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        sync();
      });
    </script>
  </body>
</html>
