---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';
import { formatDate, getPosts, excerpt } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, tags } = post.data;
const author = post.data.author ?? SITE.author;
---

<Base
  title={title}
  description={excerpt(post.body ?? '', 120)}
  image={post.data.thumbnail}
  type="article"
  publishedTime={date}
  tags={tags}
  author={author}
>
  <article class="narrow">
    <header class="article-head">
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>by {author}</span>
      </div>
      {
        tags.length > 0 && (
          <div class="tags">
            {tags.map((t) => (
              <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>
                {t}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <p><a href="/posts/">← 記事一覧へ</a></p>
  </article>
</Base>

<script>
  type TwitterAPI = { ready?: (callback: (api: TwitterAPI) => void) => void; widgets: { createTweet: (id: string, target: HTMLElement, options: Record<string, unknown>) => Promise<HTMLElement | undefined> } };
  const hosts = Array.from(document.querySelectorAll<HTMLElement>('.embed-tweet'));
  if (hosts.length) {
    const items = hosts.map(host => {
      const href = host.querySelector('a')?.href ?? '';
      const id = href.match(/status\/(\d+)/)?.[1];
      const mount = document.createElement('div');
      mount.className = 'tweet-mount';
      const fallback = document.createElement('a');
      fallback.href = href;
      fallback.className = 'tweet-fallback';
      fallback.textContent = 'Xでこの投稿を読む';
      const retry = document.createElement('button');
      retry.type = 'button';
      retry.className = 'tweet-retry';
      retry.textContent = '埋め込みを再読み込み';
      host.replaceChildren(mount, fallback, retry);
      return { host, mount, id, retry, signature: '' };
    });
    let api: TwitterAPI | undefined;
    const renderTweets = (force = false) => {
      if (!api) return;
      const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      for (const item of items) {
        if (!item.id) continue;
        const width = Math.min(550, Math.floor(item.host.getBoundingClientRect().width));
        if (width < 250) continue;
        const signature = `${theme}:${width}`;
        if (!force && item.signature === signature) continue;
        item.signature = signature;
        const next = document.createElement('div');
        next.className = 'tweet-mount';
        item.mount.replaceWith(next);
        item.mount = next;
        item.retry.hidden = true;
        void api.widgets.createTweet(item.id, next, { theme, width, dnt: true, align: 'center', lang: 'ja' })
          .then(result => { if (item.mount === next) item.retry.hidden = Boolean(result); })
          .catch(() => { if (item.mount === next) item.retry.hidden = false; });
      }
    };
    let loading = false;
    const load = () => {
      if (api) { renderTweets(true); return; }
      if (loading) return;
      loading = true;
      const script = document.createElement('script');
      script.src = 'https://platform.twitter.com/widgets.js';
      script.async = true;
      script.addEventListener('load', () => {
        loading = false;
        const twitter = (window as Window & { twttr?: TwitterAPI }).twttr;
        const ready = (value: TwitterAPI) => { api = value; renderTweets(); };
        if (twitter?.ready) twitter.ready(ready);
        else if (twitter?.widgets) ready(twitter);
      });
      script.addEventListener('error', () => { loading = false; script.remove(); });
      document.body.appendChild(script);
    };
    items.forEach(item => item.retry.addEventListener('click', load));
    new MutationObserver(() => renderTweets()).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    let timer: ReturnType<typeof setTimeout>;
    const observer = new ResizeObserver(() => {
      clearTimeout(timer);
      timer = setTimeout(() => renderTweets(), 200);
    });
    items.forEach(item => observer.observe(item.host));
    load();
  }
</script>

<script>
  // 記事内の画像をクリックすると拡大表示(絵文字画像は対象外)
  const images = Array.from(document.querySelectorAll<HTMLImageElement>('.prose img:not(.emoji)'));
  if (images.length > 0) {
    const dialog = document.createElement('dialog');
    dialog.className = 'lightbox';
    dialog.setAttribute('aria-label', '拡大表示');
    dialog.innerHTML =
      '<button type="button" class="lightbox-close" aria-label="閉じる">×</button><img alt=""><p class="lightbox-caption" hidden></p>';
    document.body.appendChild(dialog);

    const big = dialog.querySelector('img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox-caption')!;

    const open = (img: HTMLImageElement) => {
      big.src = img.currentSrc || img.src;
      big.alt = img.alt;
      const text = img.closest('figure')?.querySelector('figcaption')?.textContent ?? '';
      caption.textContent = text;
      caption.hidden = text === '';
      dialog.showModal();
    };

    for (const img of images) {
      img.classList.add('zoomable');
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.addEventListener('click', () => open(img));
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(img);
        }
      });
    }
    // どこをクリックしても閉じる(Escキーも標準で閉じる)
    dialog.addEventListener('click', () => dialog.close());
  }
</script>
