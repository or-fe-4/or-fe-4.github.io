---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import SideLinks from '../components/SideLinks.astro';
import { getPosts } from '../lib/posts';
import { top } from '../data/top';

const posts = (await getPosts()).filter((p) => !p.data.draft);
const pinned = posts.filter((p) => p.data.pinned);
---

<Base>
  <div class="top-layout">
    <div class="top-main">
      <section class="hero">
        <div class="eyebrow">PERSONAL WEBSITE / NOTES &amp; FAVORITES</div>
        <img
          class="hero-img"
          src={top.heroImage}
          alt={top.heroAlt}
          style={`--hero-ratio: ${top.heroRatio}; --hero-pos: ${top.heroPosition}`}
        />
        <h1>{top.heading}</h1>
        {top.paragraphs.map((p) => <p>{p}</p>)}
      </section>

      {
        pinned.length > 0 && (
          <section class="pinned" aria-labelledby="pinned-title">
            <h2 id="pinned-title">固定記事</h2>
            <ul class="post-list">
              {pinned.map((post) => <PostCard post={post} pinned />)}
            </ul>
          </section>
        )
      }

      {posts.length > 0 && <section class="random-section" aria-labelledby="random-title">
        <div class="section-heading">
          <h2 id="random-title">寄り道 / ランダムな記事</h2>
          <button id="random-pick" type="button" hidden>もう一つ読む</button>
        </div>
        <div id="random-posts" aria-live="polite">
          {posts.map((post, index) => <div hidden={index !== 0} class="random-entry"><ul class="post-list"><PostCard post={post} /></ul></div>)}
        </div>
      </section>}
      <p class="all-posts"><a href="/posts/">すべての記事を見る →</a></p>
    </div>

    <aside class="top-side">
      <SideLinks />
    </aside>
  </div>
</Base>

<script>
  const entries = Array.from(document.querySelectorAll<HTMLElement>('.random-entry'));
  const pick = document.getElementById('random-pick');
  let current = -1;
  function choose() {
    const candidates = entries.map((_, i) => i).filter(i => i !== current);
    const next = candidates[Math.floor(Math.random() * candidates.length)] ?? 0;
    entries.forEach((entry, i) => { entry.hidden = i !== next; });
    current = next;
  }
  if (entries.length) choose();
  if (pick && entries.length > 1) { pick.hidden = false; pick.addEventListener('click', choose); }
</script>
